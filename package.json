{
  "name": "cuban-dominoes",
  "private": true,
  "version": "0.1.0",
  "description": "Cuban double-9 dominoes — multiplayer web app monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=@dominoes/engine",
    "sim": "npm run sim --workspace=@dominoes/engine",
    "dev": "npm run dev --workspace=@dominoes/web",
    "server": "npm run dev --workspace=@dominoes/server",
    "build": "npm run build --workspace=@dominoes/web",
    "start": "NODE_ENV=production npm run start --workspace=@dominoes/server"
  }
}
